{
  "name": "swishby",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "SWISHBY \u2014 a 2027 take on the one-tap flyer: near-miss combos, phase dash, daily seeded runs.",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "test": "node --test \"tests/*.test.js\"",
    "coverage": "node --test --experimental-test-coverage \"tests/*.test.js\"",
    "build:artifact": "node scripts/build-artifact.mjs",
    "build:portal": "node scripts/portal-build.mjs",
    "build:ios": "node scripts/ios-build.mjs && npx cap sync ios"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@supabase/supabase-js": "2.117.2",
    "playwright": "^1.64.1"
  },
  "dependencies": {
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.5.3",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.3",
    "@capacitor/push-notifications": "8.1.3",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4"
  }
}
