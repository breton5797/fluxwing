# AI art pipeline — copy to .env and fill in. .env is git-ignored; never commit real keys.
# Scenario (https://app.scenario.com → Settings → API): key id:secret pair
SCENARIO_API_KEY=
SCENARIO_API_SECRET=
# The custom style model trained on art/scenario-train/crop (Scenario → Models → your model → ID, e.g. model_xxxxx)
SCENARIO_MODEL_ID=
# Ludo.ai (https://app.ludo.ai → Settings → API)
LUDO_API_KEY=
